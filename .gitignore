experiments/results/figures/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Nested upstream clones used by the byte audit — ~1.3GB of third-party code with
# its own licences and its own .git dirs, so kept on disk and out of this repo.
# experiments/byte_audit/upstream.py:MANIFEST records each URL and pinned commit,
# and Upstream.require() prints the clone command when one is missing.
baselines/h2o_official/
baselines/kivi_official/
baselines/snapkv_official/
baselines/pyramidkv_official/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz

# Re-downloadable dataset caches
experiments/suite/results/.longbench_cache/
**/.longbench_cache/

# Local agent config and secrets. These are covered by the global ignore file on
# this machine, but that does not travel with a clone or a fork, so the rule is
# repeated here where it belongs.
.claude/
.env
*.pem

# Skill ledgers. These are rewritten on every scan, so tracking them makes the
# freshness check unsatisfiable: recording a clean run is itself a tree change.
# They are local process state; the audit trail is the commit each run records.
.convergence_ledger.json
.pipeline_ledger.json
